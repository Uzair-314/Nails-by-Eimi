# Copy to .env and fill in from your Supabase project settings.
# The publishable key is safe in client code — row level security is what
# protects the data, not this key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The admin panel is a separate application. Set this and signed-in admins get
# a link to it; leave it empty and no link is shown.
VITE_ADMIN_URL=
